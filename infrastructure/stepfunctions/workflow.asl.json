{
  "Comment": "Dark Factory: AI-Driven Software Delivery Workflow with Adaptive Replanning",
  "StartAt": "PlanningAgent",
  "States": {
    "PlanningAgent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PlanningAgentArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "workflowId.$": "$.Payload.workflowId",
        "ticketId.$": "$.Payload.ticketId",
        "summary.$": "$.Payload.summary",
        "description.$": "$.Payload.description",
        "priority.$": "$.Payload.priority",
        "issueType.$": "$.Payload.issueType",
        "project.$": "$.Payload.project",
        "assignee.$": "$.Payload.assignee",
        "status.$": "$.Payload.status",
        "planning.$": "$.Payload.planning"
      },
      "ResultPath": "$",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "DevelopmentAgent"
    },
    "DevelopmentAgent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DevelopmentAgentArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "DevelopmentChoice"
    },
    "DevelopmentChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "REPLAN_REQUIRED",
          "Next": "PlanningAgent"
        },
        {
          "Variable": "$.status",
          "StringEquals": "MANUAL_REVIEW_REQUIRED",
          "Next": "ManualReviewRequired"
        },
        {
          "Variable": "$.status",
          "StringEquals": "DEVELOPMENT_ABORTED",
          "Next": "WorkflowFailed"
        }
      ],
      "Default": "ValidationAgent"
    },
    "ManualReviewRequired": {
      "Type": "Fail",
      "Cause": "Maximum replan attempts exceeded. Manual review required.",
      "Error": "ManualReviewRequired"
    },
    "ValidationAgent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ValidationAgentArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "workflowId.$": "$.Payload.workflowId",
        "ticketId.$": "$.Payload.ticketId",
        "summary.$": "$.Payload.summary",
        "description.$": "$.Payload.description",
        "priority.$": "$.Payload.priority",
        "issueType.$": "$.Payload.issueType",
        "project.$": "$.Payload.project",
        "assignee.$": "$.Payload.assignee",
        "status.$": "$.Payload.status",
        "planning.$": "$.Payload.planning",
        "artifacts.$": "$.Payload.artifacts"
      },
      "ResultPath": "$",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "ReleaseAgent"
    },
    "ReleaseAgent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReleaseAgentArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "workflowId.$": "$.Payload.workflowId",
        "ticketId.$": "$.Payload.ticketId",
        "status.$": "$.Payload.status",
        "completedAt.$": "$.Payload.completedAt",
        "artifacts.$": "$.Payload.artifacts"
      },
      "ResultPath": "$",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "WorkflowSucceeded"
    },
    "WorkflowSucceeded": {
      "Type": "Succeed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Cause": "An agent encountered an unrecoverable error.",
      "Error": "AgentExecutionFailed"
    }
  }
}
